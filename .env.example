# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local depoya eklenmez. Değişiklikten sonra siteyi yeniden derleyin (npm run build).

# Sitenin kanonik adresi (canonical, Open Graph, sitemap için). Sonunda "/" olmadan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Arama motoru indekslemesi. Yayın onayı ve içerik doğrulaması tamamlanana kadar "false".
NEXT_PUBLIC_SITE_INDEXABLE=false

# Supabase — yönetim paneli, site içeriği ve medya için. Boşsa panel "bağlantı yok"
# ekranı gösterir, site yerel varsayılan içerikle çalışır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı: iletişim formu mesajlarının kaydı ve paylaşılan hız sınırı
# sayaçları (form + panel girişi; boşsa sayaçlar bellek içi). Panel sayfaları bu anahtarı
# KULLANMAZ (panel kullanıcının kendi oturumu ve RLS ile çalışır). ASLA NEXT_PUBLIC_ önekiyle tanımlamayın.
SUPABASE_SECRET_KEY=
